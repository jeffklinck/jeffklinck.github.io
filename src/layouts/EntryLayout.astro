---
import BaseLayout from "./BaseLayout.astro";
import { formatDate } from "../lib/dates";

interface Props { title: string; description: string; eyebrow: string; date?: string; venue?: string; externalUrl?: string; visual?: number }
const { title, description, eyebrow, date, venue, externalUrl, visual } = Astro.props;
const formatted = date ? formatDate(date) : undefined;
---

<BaseLayout title={title} description={description}>
  <article class="entry">
    <header class="entry-header">
      {visual && <div class={`paper-visual visual-${visual}`} role="img" aria-label={`Abstract illustration for ${title}`}></div>}
      <p class="eyebrow">{eyebrow}{formatted && <> · {formatted}</>}{venue && <> · {venue}</>}</p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      {externalUrl && <p class="source-link"><a href={externalUrl}>Read the published paper ↗</a></p>}
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
