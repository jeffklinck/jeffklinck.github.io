---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
export async function getStaticPaths() {
  const papers = await getCollection("papers");
  return papers.map((paper) => ({ params: { slug: paper.id }, props: { paper } }));
}
const { paper } = Astro.props;
---

<BaseLayout title={paper.data.title} description={paper.data.summary}>
  <article class="prose">
    <h1>{paper.data.title}</h1>
    <p>{paper.data.abstract}</p>
    {paper.data.externalUrl && <p><a href={paper.data.externalUrl}>{site.labels.readPublishedWork}</a></p>}
    <p><a href="/professional/">{site.labels.allPapers}</a></p>
  </article>
</BaseLayout>
