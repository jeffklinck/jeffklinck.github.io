---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const page = await getEntry("pages", "professional");
if (!page) throw new Error("Missing professional page");
const { Content } = await render(page);
const papers = (await getCollection("papers")).sort((a, b) => a.data.order - b.data.order);
const experience = page.data.experience ?? [];
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="prose">
    <Content />
    <h2>Papers</h2>
    <ol class="citation-list">
      {papers.map((paper) => (
        <li>
          {paper.data.citationAuthors}, “<a href={`/papers/${paper.id}/`}>{paper.data.title}</a>,” {paper.data.citationPublication}
        </li>
      ))}
    </ol>
    <h2>Work Experience</h2>
    <div class="experience-list">
      {experience.map((item) => (
        <section>
          <h3>{item.company}</h3>
          <p><em>{item.role}</em> - {item.dates}</p>
          <p>{item.summary}</p>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
