---
import { getCollection, render } from "astro:content";
import EntryLayout from "../../layouts/EntryLayout.astro";
export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
---

<EntryLayout title={note.data.title} description={note.data.summary} eyebrow={note.data.eyebrow} date={note.data.date}>
  <Content />
  <a class="back-link" href="/personal/">← All notes</a>
</EntryLayout>
