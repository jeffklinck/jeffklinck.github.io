---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/dates";
const page = await getEntry("pages", "personal");
if (!page) throw new Error("Missing personal page");
const { Content } = await render(page);
const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="prose">
    <Content />
    <h2>Notes</h2>
    <ul>
      {notes.map((note) => (
        <li>
          <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          {` - ${formatDate(note.data.date)}`}
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>
